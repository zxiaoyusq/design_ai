{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/design-dna-multitag-observation-v1.json",
  "title": "Multimodal Design DNA Multi-tag Model Observation",
  "description": "Lean model-authored visual and semantic observations; the host compiles deterministic metadata, statistics, ordering, references, and final result fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_base_version",
    "target_object",
    "image_quality",
    "active_profiles",
    "rule_adaptations",
    "style_observations",
    "design_observations",
    "uncertainties",
    "novel_dna_elements",
    "evidence",
    "quality_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "design_dna_multitag_observation_v1"
    },
    "knowledge_base_version": {
      "const": "4.1"
    },
    "target_object": {
      "$ref": "#/$defs/targetObject"
    },
    "image_quality": {
      "$ref": "#/$defs/imageQuality"
    },
    "active_profiles": {
      "type": "array",
      "items": {
        "enum": [
          "core",
          "profile:device_controls",
          "profile:imaging_device",
          "profile:screen_device",
          "profile:handled_object",
          "profile:portable_object",
          "profile:contact_surface"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "core"
      }
    },
    "rule_adaptations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleAdaptation"
      }
    },
    "style_observations": {
      "$ref": "#/$defs/styleObservations"
    },
    "design_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/designObservation"
      },
      "minItems": 1
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertaintyObservation"
      }
    },
    "novel_dna_elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/novelDna"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "quality_notes": {
      "$ref": "#/$defs/qualityNotes"
    }
  },
  "$defs": {
    "targetObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "category",
        "subcategory",
        "selection_basis",
        "selection_confidence",
        "bbox_norm",
        "view",
        "visible_regions",
        "ignored_content"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        },
        "selection_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox_norm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "view": {
          "enum": [
            "front",
            "rear",
            "left",
            "right",
            "top",
            "bottom",
            "three_quarter",
            "detail",
            "unknown"
          ]
        },
        "visible_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ignored_content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "imageQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_quality",
        "object_visible_ratio",
        "occlusion_level",
        "blur_level",
        "exposure_risk",
        "perspective_distortion",
        "background_interference",
        "lighting_bias",
        "color_reliability",
        "material_reliability",
        "notes"
      ],
      "properties": {
        "overall_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "object_visible_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "occlusion_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exposure_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "perspective_distortion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "background_interference": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lighting_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color_reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "material_reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "candidateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "probability",
        "supporting_evidence_refs",
        "contradicting_evidence_refs"
      ],
      "properties": {
        "value": {},
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supporting_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        },
        "contradicting_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "bbox_norm",
        "region",
        "view",
        "description",
        "visual_cues"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[A-Za-z0-9_-]+$"
        },
        "bbox_norm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "enum": [
            "front",
            "rear",
            "left",
            "right",
            "top",
            "bottom",
            "three_quarter",
            "detail",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "visual_cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "novelDna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temp_id",
        "novelty_type",
        "proposed_module_id",
        "existing_field_id",
        "proposed_module_name",
        "proposed_field_name",
        "definition",
        "observed_value",
        "recommended_value_type",
        "recommended_value_space_or_measurement",
        "applicable_categories",
        "region",
        "distinct_from_existing_fields",
        "design_relevance",
        "confidence",
        "evidence_refs",
        "suggested_priority"
      ],
      "properties": {
        "temp_id": {
          "type": "string",
          "pattern": "^NEW-[A-Za-z0-9_-]+$"
        },
        "novelty_type": {
          "enum": [
            "new_module",
            "new_field",
            "new_enum_value",
            "new_relation_rule"
          ]
        },
        "proposed_module_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "existing_field_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_module_name": {
          "type": "string",
          "minLength": 1
        },
        "proposed_field_name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "observed_value": {},
        "recommended_value_type": {
          "enum": [
            "enum",
            "float",
            "continuous",
            "integer",
            "boolean",
            "multi_label",
            "list",
            "object",
            "text"
          ]
        },
        "recommended_value_space_or_measurement": {},
        "applicable_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "distinct_from_existing_fields": {
          "type": "string",
          "minLength": 1
        },
        "design_relevance": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EV-[A-Za-z0-9_-]+$"
              },
              "uniqueItems": true
            },
            {
              "minItems": 1
            }
          ]
        },
        "suggested_priority": {
          "enum": [
            "P0",
            "P1",
            "observe_more"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "novelty_type": {
                "const": "new_enum_value"
              }
            },
            "required": [
              "novelty_type"
            ]
          },
          "then": {
            "properties": {
              "existing_field_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,3}$"
              },
              "recommended_value_type": {
                "const": "enum"
              }
            }
          },
          "else": {
            "properties": {
              "existing_field_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "enum": [
                  "enum",
                  "text"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "enum": [
                  "float",
                  "continuous"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "multi_label"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "object"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "ruleAdaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_rule",
        "status",
        "adapted_rule",
        "reason"
      ],
      "properties": {
        "source_rule": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "adapted",
            "not_applicable"
          ]
        },
        "adapted_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "adapted"
              }
            }
          },
          "then": {
            "properties": {
              "adapted_rule": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "adapted_rule": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "designObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "value",
        "raw_visual_description",
        "region",
        "observability",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,3}$"
        },
        "value": {},
        "raw_visual_description": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "observability": {
          "enum": [
            "observed",
            "not_observable",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "confirmedStyleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_id",
        "match_score",
        "confidence",
        "dominance",
        "regions",
        "applicable_rule_count",
        "not_applicable_rule_count",
        "color_requirement_status",
        "core_feature_hits",
        "auxiliary_feature_hits"
      ],
      "properties": {
        "style_id": {
          "enum": [
            "PureMinimalism",
            "NordicCalm",
            "RefinedMinimalism",
            "PrecisionMinimalism",
            "SoftContemporary",
            "ModernPrestige",
            "ClassicPrestige",
            "DecorativeLuxury",
            "MaturePremium",
            "PureFuture",
            "MechanicalTech",
            "CyberNeon",
            "ArcaneFuture",
            "ParametricTech",
            "TechComposition",
            "KineticEnergy",
            "ArmorPower",
            "FunctionalAesthetics",
            "NaturalTextures",
            "BiomorphicForm",
            "MysticOrganic",
            "RefinedWilderness",
            "FreshJoy",
            "SaturatedBold",
            "DreamyAir",
            "Y2KDigital",
            "FashionGraphic",
            "NeoRetro",
            "FolkOrnament",
            "ExpressiveMotifs",
            "PlayfulGeometry",
            "CharacterMorph",
            "InflatedForm",
            "LayeredTransparency",
            "DeconstructedAssembly",
            "DigitalGlitch",
            "BrutalistMassing",
            "CraftedIrregularity"
          ]
        },
        "match_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1
        },
        "dominance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "applicable_rule_count": {
          "type": "integer",
          "minimum": 1
        },
        "not_applicable_rule_count": {
          "type": "integer",
          "minimum": 0
        },
        "color_requirement_status": {
          "enum": [
            "pass",
            "not_applicable"
          ]
        },
        "core_feature_hits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "auxiliary_feature_hits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "otherStyleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_id",
        "match_score",
        "confidence",
        "regions",
        "candidate_status",
        "hard_rule_passed",
        "main_support",
        "main_conflicts"
      ],
      "properties": {
        "style_id": {
          "enum": [
            "PureMinimalism",
            "NordicCalm",
            "RefinedMinimalism",
            "PrecisionMinimalism",
            "SoftContemporary",
            "ModernPrestige",
            "ClassicPrestige",
            "DecorativeLuxury",
            "MaturePremium",
            "PureFuture",
            "MechanicalTech",
            "CyberNeon",
            "ArcaneFuture",
            "ParametricTech",
            "TechComposition",
            "KineticEnergy",
            "ArmorPower",
            "FunctionalAesthetics",
            "NaturalTextures",
            "BiomorphicForm",
            "MysticOrganic",
            "RefinedWilderness",
            "FreshJoy",
            "SaturatedBold",
            "DreamyAir",
            "Y2KDigital",
            "FashionGraphic",
            "NeoRetro",
            "FolkOrnament",
            "ExpressiveMotifs",
            "PlayfulGeometry",
            "CharacterMorph",
            "InflatedForm",
            "LayeredTransparency",
            "DeconstructedAssembly",
            "DigitalGlitch",
            "BrutalistMassing",
            "CraftedIrregularity"
          ]
        },
        "match_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "candidate_status": {
          "enum": [
            "provisional",
            "rejected"
          ]
        },
        "hard_rule_passed": {
          "type": "boolean"
        },
        "main_support": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "main_conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hard_rule_passed": {
                "const": true
              }
            },
            "required": [
              "hard_rule_passed"
            ]
          },
          "then": {
            "properties": {
              "main_conflicts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "pairwiseReasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_id_a",
        "style_id_b",
        "reason"
      ],
      "properties": {
        "style_id_a": {
          "enum": [
            "PureMinimalism",
            "NordicCalm",
            "RefinedMinimalism",
            "PrecisionMinimalism",
            "SoftContemporary",
            "ModernPrestige",
            "ClassicPrestige",
            "DecorativeLuxury",
            "MaturePremium",
            "PureFuture",
            "MechanicalTech",
            "CyberNeon",
            "ArcaneFuture",
            "ParametricTech",
            "TechComposition",
            "KineticEnergy",
            "ArmorPower",
            "FunctionalAesthetics",
            "NaturalTextures",
            "BiomorphicForm",
            "MysticOrganic",
            "RefinedWilderness",
            "FreshJoy",
            "SaturatedBold",
            "DreamyAir",
            "Y2KDigital",
            "FashionGraphic",
            "NeoRetro",
            "FolkOrnament",
            "ExpressiveMotifs",
            "PlayfulGeometry",
            "CharacterMorph",
            "InflatedForm",
            "LayeredTransparency",
            "DeconstructedAssembly",
            "DigitalGlitch",
            "BrutalistMassing",
            "CraftedIrregularity"
          ]
        },
        "style_id_b": {
          "enum": [
            "PureMinimalism",
            "NordicCalm",
            "RefinedMinimalism",
            "PrecisionMinimalism",
            "SoftContemporary",
            "ModernPrestige",
            "ClassicPrestige",
            "DecorativeLuxury",
            "MaturePremium",
            "PureFuture",
            "MechanicalTech",
            "CyberNeon",
            "ArcaneFuture",
            "ParametricTech",
            "TechComposition",
            "KineticEnergy",
            "ArmorPower",
            "FunctionalAesthetics",
            "NaturalTextures",
            "BiomorphicForm",
            "MysticOrganic",
            "RefinedWilderness",
            "FreshJoy",
            "SaturatedBold",
            "DreamyAir",
            "Y2KDigital",
            "FashionGraphic",
            "NeoRetro",
            "FolkOrnament",
            "ExpressiveMotifs",
            "PlayfulGeometry",
            "CharacterMorph",
            "InflatedForm",
            "LayeredTransparency",
            "DeconstructedAssembly",
            "DigitalGlitch",
            "BrutalistMassing",
            "CraftedIrregularity"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "styleObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification_status",
        "confirmed_tags",
        "other_candidates",
        "pairwise_reasoning",
        "composition_summary"
      ],
      "properties": {
        "classification_status": {
          "enum": [
            "confirmed",
            "unclassified"
          ]
        },
        "confirmed_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confirmedStyleObservation"
          },
          "maxItems": 3
        },
        "other_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/otherStyleCandidate"
          }
        },
        "pairwise_reasoning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairwiseReasoning"
          },
          "maxItems": 3
        },
        "composition_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification_status": {
                "const": "confirmed"
              }
            },
            "required": [
              "classification_status"
            ]
          },
          "then": {
            "properties": {
              "confirmed_tags": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification_status": {
                "const": "unclassified"
              }
            },
            "required": [
              "classification_status"
            ]
          },
          "then": {
            "properties": {
              "confirmed_tags": {
                "maxItems": 0
              },
              "other_candidates": {
                "minItems": 1
              },
              "pairwise_reasoning": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmed_tags": {
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "confirmed_tags"
            ]
          },
          "then": {
            "properties": {
              "pairwise_reasoning": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmed_tags": {
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "confirmed_tags"
            ]
          },
          "then": {
            "properties": {
              "pairwise_reasoning": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      ]
    },
    "uncertaintyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "region",
        "reason_type",
        "reason",
        "observability",
        "confidence",
        "evidence_refs",
        "best_estimate",
        "candidate_values",
        "recommended_additional_view_or_info"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,3}$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "reason_type": {
          "enum": [
            "low_confidence",
            "low_visibility",
            "occlusion",
            "blur",
            "lighting",
            "reflection",
            "perspective",
            "multiple_candidates",
            "not_observable",
            "missing_reference",
            "not_computable",
            "definition_gap",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observability": {
          "enum": [
            "observed",
            "not_observable",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.749999
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        },
        "best_estimate": {},
        "candidate_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateValue"
          },
          "maxItems": 3
        },
        "recommended_additional_view_or_info": {
          "type": "string"
        }
      }
    },
    "qualityNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_critical_fields",
        "warnings",
        "concise_summary"
      ],
      "properties": {
        "missing_critical_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "concise_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/design-dna-multitag-output-v1.3.json",
  "title": "Multimodal Design DNA Multi-tag Extraction Output",
  "description": "Single-primary-object design DNA extraction result with ranked flat style candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_base_version",
    "target_object",
    "image_quality",
    "module_applicability",
    "style_result",
    "design_elements",
    "novel_dna_elements",
    "evidence",
    "quality_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "design_dna_multitag_extraction_v1.3"
    },
    "knowledge_base_version": {
      "const": "4.1"
    },
    "target_object": {
      "$ref": "#/$defs/targetObject"
    },
    "image_quality": {
      "$ref": "#/$defs/imageQuality"
    },
    "module_applicability": {
      "$ref": "#/$defs/moduleApplicability"
    },
    "style_result": {
      "$ref": "#/$defs/styleResult"
    },
    "design_elements": {
      "$ref": "#/$defs/designElements"
    },
    "novel_dna_elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/novelDna"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "quality_summary": {
      "$ref": "#/$defs/qualitySummary"
    }
  },
  "$defs": {
    "targetObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "category",
        "subcategory",
        "selection_basis",
        "selection_confidence",
        "bbox_norm",
        "view",
        "visible_regions",
        "ignored_content"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        },
        "selection_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox_norm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "view": {
          "enum": [
            "front",
            "rear",
            "left",
            "right",
            "side",
            "top",
            "bottom",
            "three_quarter",
            "detail",
            "unknown"
          ]
        },
        "visible_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ignored_content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "imageQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_quality",
        "object_visible_ratio",
        "occlusion_level",
        "blur_level",
        "exposure_risk",
        "perspective_distortion",
        "background_interference",
        "lighting_bias",
        "color_reliability",
        "material_reliability",
        "notes"
      ],
      "properties": {
        "overall_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "object_visible_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "occlusion_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exposure_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "perspective_distortion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "background_interference": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lighting_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color_reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "material_reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "moduleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_name",
        "reason"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "excludedModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_name",
        "reason",
        "explanation"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "category_not_applicable",
            "profile_not_applicable",
            "other"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleAdaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_rule",
        "status",
        "adapted_rule",
        "reason"
      ],
      "properties": {
        "source_rule": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "adapted",
            "not_applicable"
          ]
        },
        "adapted_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "adapted"
              }
            }
          },
          "then": {
            "properties": {
              "adapted_rule": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "adapted_rule": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "moduleApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_profiles",
        "applicable_modules",
        "excluded_modules",
        "rule_adaptations"
      ],
      "properties": {
        "active_profiles": {
          "type": "array",
          "items": {
            "enum": [
              "core",
              "profile:device_controls",
              "profile:imaging_device",
              "profile:screen_device",
              "profile:handled_object",
              "profile:portable_object",
              "profile:contact_surface"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "core"
          }
        },
        "applicable_modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleRef"
          }
        },
        "excluded_modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excludedModule"
          },
          "contains": {
            "type": "object",
            "properties": {
              "module_id": {
                "const": "DNA-M15"
              },
              "reason": {
                "const": "profile_not_applicable"
              }
            },
            "required": [
              "module_id",
              "reason"
            ]
          }
        },
        "rule_adaptations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleAdaptation"
          }
        }
      }
    },
    "styleId": {
      "enum": [
        "PureMinimalism",
        "NordicCalm",
        "RefinedMinimalism",
        "PrecisionMinimalism",
        "SoftContemporary",
        "ModernPrestige",
        "ClassicPrestige",
        "DecorativeLuxury",
        "MaturePremium",
        "PureFuture",
        "MechanicalTech",
        "CyberNeon",
        "ArcaneFuture",
        "ParametricTech",
        "TechComposition",
        "KineticEnergy",
        "ArmorPower",
        "FunctionalAesthetics",
        "NaturalTextures",
        "BiomorphicForm",
        "MysticOrganic",
        "RefinedWilderness",
        "FreshJoy",
        "SaturatedBold",
        "DreamyAir",
        "Y2KDigital",
        "FashionGraphic",
        "NeoRetro",
        "FolkOrnament",
        "ExpressiveMotifs",
        "PlayfulGeometry",
        "CharacterMorph",
        "InflatedForm",
        "LayeredTransparency",
        "DeconstructedAssembly",
        "DigitalGlitch",
        "BrutalistMassing",
        "CraftedIrregularity"
      ]
    },
    "styleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "style_id",
        "label_en",
        "label_zh",
        "aliases",
        "tag_kind",
        "facet_ids",
        "match_score",
        "confidence",
        "regions",
        "main_support",
        "main_conflicts"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "style_id": {"$ref": "#/$defs/styleId"},
        "label_en": {"type": "string", "minLength": 1},
        "label_zh": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "tag_kind": {"type": "string", "minLength": 1},
        "facet_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "match_score": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "regions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "main_support": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "main_conflicts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "derivedStylePreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset_id", "label_en", "label_zh", "matched_style_ids"],
      "properties": {
        "preset_id": {
          "enum": [
            "CyberAesthetic",
            "PlayfulAesthetic",
            "MemphisAesthetic",
            "KawaiiAesthetic",
            "GummyAesthetic",
            "RetroFuture",
            "SteampunkAesthetic",
            "SolarpunkAesthetic",
            "NeoDecoAesthetic",
            "JapandiAesthetic",
            "DarkRomanticAesthetic",
            "MaximalistAesthetic"
          ]
        },
        "label_en": {"type": "string", "minLength": 1},
        "label_zh": {"type": "string", "minLength": 1},
        "matched_style_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/styleId"},
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "styleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_candidates",
        "derived_style_presets",
        "composition_summary"
      ],
      "properties": {
        "style_candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/styleCandidate"},
          "maxItems": 5
        },
        "derived_style_presets": {
          "type": "array",
          "items": {"$ref": "#/$defs/derivedStylePreset"},
          "maxItems": 12,
          "uniqueItems": true
        },
        "composition_summary": {"type": "string", "minLength": 1}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_name",
        "source_path",
        "schema_source",
        "value",
        "raw_visual_description",
        "value_type",
        "evidence_mode",
        "region",
        "applicability_status",
        "observability",
        "computation_status",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "field_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "schema_source": {
          "enum": [
            "md_original",
            "md_extension"
          ]
        },
        "value": {},
        "raw_visual_description": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "enum",
            "float",
            "integer",
            "boolean",
            "list",
            "object",
            "text",
            "multi_label"
          ]
        },
        "evidence_mode": {
          "enum": [
            "direct",
            "derived",
            "inferred",
            "reference_computed"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "applicability_status": {
          "const": "applicable"
        },
        "observability": {
          "enum": [
            "observed",
            "not_observable",
            "unknown"
          ]
        },
        "computation_status": {
          "enum": [
            "computed",
            "not_computable",
            "not_requested"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_source": {
                "const": "md_extension"
              }
            },
            "required": [
              "schema_source"
            ]
          },
          "then": {
            "properties": {
              "field_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,3}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "const": "direct"
              }
            },
            "required": [
              "evidence_mode"
            ]
          },
          "then": {
            "properties": {
              "computation_status": {
                "const": "not_requested"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "enum": [
                  "derived",
                  "inferred",
                  "reference_computed"
                ]
              }
            },
            "required": [
              "evidence_mode"
            ]
          },
          "then": {
            "properties": {
              "computation_status": {
                "enum": [
                  "computed",
                  "not_computable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "const": "direct"
              },
              "observability": {
                "const": "observed"
              }
            },
            "required": [
              "evidence_mode",
              "observability"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "const": "direct"
              },
              "observability": {
                "enum": [
                  "not_observable",
                  "unknown"
                ]
              }
            },
            "required": [
              "evidence_mode",
              "observability"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "enum": [
                  "derived",
                  "inferred",
                  "reference_computed"
                ]
              },
              "computation_status": {
                "const": "computed"
              }
            },
            "required": [
              "evidence_mode",
              "computation_status"
            ]
          },
          "then": {
            "properties": {
              "observability": {
                "const": "observed"
              },
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "enum": [
                  "derived",
                  "inferred",
                  "reference_computed"
                ]
              },
              "computation_status": {
                "enum": [
                  "not_computable",
                  "not_requested"
                ]
              }
            },
            "required": [
              "evidence_mode",
              "computation_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "const": "derived"
              },
              "computation_status": {
                "const": "computed"
              }
            },
            "required": [
              "evidence_mode",
              "computation_status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_mode": {
                "const": "inferred"
              },
              "computation_status": {
                "const": "computed"
              }
            },
            "required": [
              "evidence_mode",
              "computation_status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "enum",
                  "text"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "float",
                  "continuous"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "integer"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "list"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "array",
                  "null"
                ],
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "multi_label"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "object"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      ]
    },
    "originalDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "elements"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "ID形态",
            "相机架构",
            "颜色",
            "材质工艺",
            "纹理图案",
            "设计细节"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "extendedModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_name",
        "elements"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^DNA-M(0[1-9]|1[0-5])$"
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "designElements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_md_dimensions",
        "extended_dna_modules"
      ],
      "properties": {
        "original_md_dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalDimension"
          },
          "maxItems": 0
        },
        "extended_dna_modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extendedModule"
          }
        }
      }
    },
    "novelDna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temp_id",
        "novelty_type",
        "proposed_module_id",
        "existing_field_id",
        "proposed_module_name",
        "proposed_field_name",
        "definition",
        "observed_value",
        "recommended_value_type",
        "recommended_value_space_or_measurement",
        "applicable_categories",
        "region",
        "distinct_from_existing_fields",
        "design_relevance",
        "confidence",
        "evidence_refs",
        "suggested_priority"
      ],
      "properties": {
        "temp_id": {
          "type": "string",
          "pattern": "^NEW-[A-Za-z0-9_-]+$"
        },
        "novelty_type": {
          "enum": [
            "new_module",
            "new_field",
            "new_enum_value",
            "new_relation_rule"
          ]
        },
        "proposed_module_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "existing_field_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_module_name": {
          "type": "string",
          "minLength": 1
        },
        "proposed_field_name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "observed_value": {},
        "recommended_value_type": {
          "enum": [
            "enum",
            "float",
            "continuous",
            "integer",
            "boolean",
            "multi_label",
            "list",
            "object",
            "text"
          ]
        },
        "recommended_value_space_or_measurement": {},
        "applicable_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "distinct_from_existing_fields": {
          "type": "string",
          "minLength": 1
        },
        "design_relevance": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^EV-[A-Za-z0-9_-]+$"
              },
              "uniqueItems": true
            },
            {
              "minItems": 1
            }
          ]
        },
        "suggested_priority": {
          "enum": [
            "P0",
            "P1",
            "observe_more"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "novelty_type": {
                "const": "new_enum_value"
              }
            },
            "required": [
              "novelty_type"
            ]
          },
          "then": {
            "properties": {
              "existing_field_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,3}$"
              },
              "recommended_value_type": {
                "const": "enum"
              }
            }
          },
          "else": {
            "properties": {
              "existing_field_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "enum": [
                  "enum",
                  "text"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "enum": [
                  "float",
                  "continuous"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "multi_label"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommended_value_type": {
                "const": "object"
              }
            }
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "bbox_norm",
        "region",
        "view",
        "description",
        "visual_cues"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[A-Za-z0-9_-]+$"
        },
        "bbox_norm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "enum": [
            "front",
            "rear",
            "left",
            "right",
            "side",
            "top",
            "bottom",
            "three_quarter",
            "detail",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "visual_cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible_coverage",
        "mean_confidence",
        "style_confidence",
        "low_confidence_field_count",
        "missing_critical_fields",
        "warnings",
        "concise_summary"
      ],
      "properties": {
        "visible_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "low_confidence_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_critical_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "concise_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

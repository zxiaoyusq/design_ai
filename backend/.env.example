LLM_KEY=replace-with-your-api-key
LLM_URL=https://your-llm-gateway.example.com

# 独立的 PostgreSQL 账号库；本机 compose 端口为 55434。
AUTH_POSTGRES_PASSWORD=replace-with-a-random-database-password
AUTH_DATABASE_URL=postgresql+psycopg://design_ai_auth:replace-with-a-random-database-password@127.0.0.1:55434/design_ai_auth
AUTH_SESSION_SECONDS=43200
# HTTPS 请求自动设置 Secure；纯 HTTPS 部署也可强制为 true。
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://gamedevcenter.ahagamecenter.com,https://gamedevcenter.ahagamecenter.com
